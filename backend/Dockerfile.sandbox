ARG CODEX_CLI_VERSION=latest

FROM node:22-slim AS node-base
ARG CODEX_CLI_VERSION
RUN npm install -g "@openai/codex@${CODEX_CLI_VERSION}" \
    && codex --version

FROM python:3.11-slim

ENV CODEX_HOME=/root/.codex

COPY --from=node-base /usr/local/bin/node /usr/local/bin/node
COPY --from=node-base /usr/local/bin/npm /usr/local/bin/npm
COPY --from=node-base /usr/local/bin/npx /usr/local/bin/npx
COPY --from=node-base /usr/local/bin/corepack /usr/local/bin/corepack
COPY --from=node-base /usr/local/bin/codex /usr/local/bin/codex
COPY --from=node-base /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    ln -sf ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack && \
    ln -sf ../lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex

# Install system dependencies needed for Foundry, Node projects, and Rust/Soroban repos.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Foundry
ENV FOUNDRY_DIR=/opt/foundry
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="${FOUNDRY_DIR}/bin:${CARGO_HOME}/bin:${PATH}"
RUN curl -L https://foundry.paradigm.xyz | bash && \
    foundryup && \
    curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal && \
    rustup component add rust-src && \
    rustup target add wasm32-unknown-unknown wasm32v1-none && \
    cargo install --locked stellar-cli && \
    corepack enable && \
    mkdir -p "$CODEX_HOME" && \
    codex --version && \
    forge --version && \
    stellar --version && \
    cargo --version && \
    node --version

WORKDIR /sandbox

# Install Python requirements for the sandbox API
RUN pip install --no-cache-dir fastapi uvicorn python-multipart

COPY worker/verifier/sandbox_api.py /sandbox/sandbox_api.py

# Run the FastAPI server
CMD ["uvicorn", "sandbox_api:app", "--host", "0.0.0.0", "--port", "8080"]
