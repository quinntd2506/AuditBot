ARG CODEX_CLI_VERSION=latest

FROM node:22-slim AS codex-cli
ARG CODEX_CLI_VERSION
RUN npm install -g "@openai/codex@${CODEX_CLI_VERSION}" \
    && codex --version

FROM python:3.11-slim

ENV CODEX_HOME=/root/.codex
ENV FOUNDRY_DIR=/root/.foundry
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/root/.foundry/bin:${CARGO_HOME}/bin:${PATH}"

WORKDIR /app

COPY --from=codex-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-cli /usr/local/bin/npm /usr/local/bin/npm
COPY --from=codex-cli /usr/local/bin/npx /usr/local/bin/npx
COPY --from=codex-cli /usr/local/bin/corepack /usr/local/bin/corepack
COPY --from=codex-cli /usr/local/bin/codex /usr/local/bin/codex
COPY --from=codex-cli /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -sf ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && ln -sf ../lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        build-essential \
        pkg-config \
        libssl-dev \
    && curl -L https://foundry.paradigm.xyz | bash \
    && foundryup \
    && curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal \
    && rustup component add rust-src \
    && rustup target add wasm32-unknown-unknown wasm32v1-none \
    && cargo install --locked stellar-cli \
    && corepack enable \
    && mkdir -p "$CODEX_HOME" \
    && codex --version \
    && forge --version \
    && stellar --version \
    && cargo --version \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . /app/
ENV PYTHONPATH=/app
CMD ["sh", "-c", "python3 init_db.py && python3 -u -m worker/worker.py"]
