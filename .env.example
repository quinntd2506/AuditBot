# for local testing
POSTGRES_HOST=localhost
REDIS_HOST=localhost
# ─── Infrastructure (Docker) ──────────────────────────────────────────────────
# The password for the PostgreSQL root user.
POSTGRES_PASSWORD=SECURE_PASSWORD_HERE

# Connection strings used by the API and Worker.
# Note: 'postgres' and 'redis' are the service names inside Docker.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/auditbot
REDIS_URL=redis://redis:6381/0

# ─── App Settings ─────────────────────────────────────────────────────────────
API_PORT=8001
FRONTEND_PORT=5173

# ─── Platform: Guardian Defender ──────────────────────────────────────────────
GUARDIAN_EMAIL="your.email@example.com"
GUARDIAN_PASSWORD="password_here"

# ─── Platform: Cantina ──────────────────────────────────────────────
CANTINA_EMAIL="your.email@example.com"
CANTINA_PASSWORD="password_here"

# ─── Platform: Sherlock Audits ─────────────────────────────────────────────────
# Retrieve this from browser console while logged into Sherlock
SHERLOCK_SESSION_COOKIE="cookie_here"

# ─── Platform: Code4rena ──────────────────────────────────────────────
CODE4RENA_USERNAME="your_username"
CODE4RENA_PASSWORD="password_here"

# ─── Platform: Immunefi ───────────────────────────────────────────────
IMMUNEFI_EMAIL="your.email@example.com"
IMMUNEFI_PASSWORD="password_here"

# ─── Platform: Trufy Audits ──────────────────────────────────────────────
TRUFY_EMAIL="your.email@example.com"
TRUFY_PASSWORD="password_here"

# ─── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN="ghp_token_here"

# ─── Codex Verifier ───────────────────────────────────────────────────────────
# CODEX_MODEL can be left blank to use the Codex CLI default model.
CODEX_MODEL=""
CODEX_TRIAGE_SANDBOX=read-only
CODEX_POC_SANDBOX=workspace-write
CODEX_APPROVAL=never
CODEX_TIMEOUT=600
